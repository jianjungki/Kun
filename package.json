{
  "name": "pengcodex",
  "productName": "PengCodex",
  "version": "0.1.0",
  "description": "Local-first desktop AI workbench for PengCodex Core (HTTP/SSE)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:kun && electron-vite dev",
    "build": "npm run build:kun && electron-vite build",
    "build:kun": "node ./scripts/ensure-kun-install.cjs && npm --prefix kun run build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never",
    "dist:mac": "rm -f dist/PengCodex-*-mac-* dist/latest-mac.yml && npm run build && npm run dist:mac:x64:dmg && npm run dist:mac:x64:zip && npm run dist:mac:arm64:dmg && npm run dist:mac:arm64:zip && node ./scripts/generate-mac-latest.cjs dist",
    "dist:mac:signed": "rm -f dist/PengCodex-*-mac-* dist/latest-mac.yml && MAC_SIGN=1 npm run dist:mac:x64 && MAC_SIGN=1 npm run dist:mac:arm64 && node ./scripts/generate-mac-latest.cjs dist",
    "dist:mac:arm64": "npm run build && npm run dist:mac:arm64:dmg && npm run dist:mac:arm64:zip",
    "dist:mac:x64": "npm run build && npm run dist:mac:x64:dmg && npm run dist:mac:x64:zip",
    "dist:mac:arm64:dmg": "npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --mac dmg --arm64",
    "dist:mac:x64:dmg": "npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --mac dmg --x64",
    "dist:mac:arm64:zip": "node ./scripts/zip-mac-app.cjs arm64",
    "dist:mac:x64:zip": "node ./scripts/zip-mac-app.cjs x64",
    "dist:win": "npm run dist -- --win nsis portable --x64 && node ./scripts/generate-win-latest.cjs",
    "dist:win:portable": "npm run build && npx --yes electron-builder@26.15.3 --config electron-builder.config.cjs --publish never --win portable --x64",
    "dist:linux": "npm run dist -- --linux AppImage --x64",
    "release:all": "bash ./scripts/release-mac.sh",
    "release:mac": "bash ./scripts/release-mac.sh",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-win.ps1",
    "r2:upload": "node ./scripts/publish-r2.mjs upload",
    "r2:promote": "node ./scripts/publish-r2.mjs promote",
    "postinstall": "node ./scripts/postinstall.cjs",
    "verify:apple": "node ./scripts/verify-apple-signing.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "mac:unquarantine": "bash ./scripts/mac-unquarantine.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tencent-weixin/openclaw-weixin": "2.4.3",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^10.1.0",
    "html-to-docx": "^1.8.0",
    "i18next": "^25.10.10",
    "lucide-react": "^0.544.0",
    "openclaw": "file:vendor\\openclaw-shim",
    "punycode": "2.3.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "rehype-harden": "^1.1.8",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hast": "3.0.4",
    "@types/html-to-docx": "^1.8.1",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^39.8.10",
    "electron-vite": "^3.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unified": "11.0.5",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "author": "PengCodex Contributors",
  "homepage": "https://github.com/XingYu-Zhong/PengCodex",
  "repository": {
    "type": "git",
    "url": "https://github.com/XingYu-Zhong/PengCodex.git"
  }
}
